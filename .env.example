# Local API binds to loopback. Public hosting requires authentication before writes.
HOST=127.0.0.1
PORT=8787
ALLOW_EVENT_WRITES=true
# Add https://localhost for the Capacitor Android WebView; list exact origins only.
ACCESSROUTE_CORS_ORIGINS=https://localhost
SESSIONS_FILE=data/runtime/sessions.json
# VITE_PROVIDER=static (default) or http
# BASE_PATH=/repository-name/ (GitHub Pages build only)

# Qwen credentials are read by the backend only.
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_TEXT_MODEL=qwen-plus
QWEN_VISION_MODEL=qwen-vl-max
# Optional Azure Speech TTS. When both values are set, the backend uses Cantonese neural voices.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Optional local Cantonese TTS; start it with `npm run dev:canto-tts`.
# CANTO_TTS_URL=http://127.0.0.1:8000/synthesize
# Alternative compatible service verified in docs/qa/qwen-live.md:
# QWEN_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
# QWEN_TEXT_MODEL=qwen3.8-max
# QWEN_VISION_MODEL=qwen3-vl-plus
